{
  "expo": {
    "name": "NessaHub",
    "slug": "telehealth-client-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ness-splash.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ness-splash.jpeg",
      "resizeMode": "cover",
      "backgroundColor": "#4a7c59"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nessahub.client",
      "infoPlist": {
        "NSFaceIDUsageDescription": "NessaHub uses Face ID so you can sign in without typing your password. Your face data never leaves your device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#4a7c59"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nessahub.client",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NessaHub uses Face ID so you can sign in without typing your password."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "nessahub"
  }
}
